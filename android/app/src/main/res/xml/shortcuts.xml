<?xml version="1.0" encoding="utf-8"?>
<!-- System-native entry to Settings & privacy: long-press the SlowGram
     launcher icon. Keeps the WebView surface 100% clean (no floating UI
     over the Instagram page). Static shortcuts require API 25+; on API 24
     the shortcut is simply absent (Android 7 is not a supported target). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/settings_title"
        android:shortcutLongLabel="@string/settings_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.slowgram.app"
            android:targetClass="com.slowgram.app.SettingsActivity" />
    </shortcut>
</shortcuts>
