<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111" />

        <!-- Privacidade -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_privacy_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_privacy_body"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#222" />

        <!-- Sobre o SlowGram -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_intro"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_objective_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_objective"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_open_source_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_open_source"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#222" />

        <Button
            android:id="@+id/settings_github_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/about_github_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/about_disclaimer"
            android:textSize="12sp"
            android:textColor="#666" />
    </LinearLayout>
</ScrollView>
